#  / / \ \ / / \ \ / / \ \ / / \ \ / / \ \ / / \ \ / / \ \ / / \
# `-'   `-`-'   `-`-'   `-`-'   `-`-'   `-`-'   `-`-'   `-`-'
#
#               Example environment configuration
#
#   .-.-.   .-.-.   .-.-.   .-.-.   .-.-.   .-.-.   .-.-.   .-.-
#  / / \ \ / / \ \ / / \ \ / / \ \ / / \ \ / / \ \ / / \ \ / / \
# `-'   `-`-'   `-`-'   `-`-'   `-`-'   `-`-'   `-`-'   `-`-'

# Authenticate with a single private key for all chains
PRIVATE_KEY=

# RPC endpoints (override if you have your own providers)
RPC_URL_HEDERA_TESTNET=https://testnet.hashio.io/api
RPC_URL_BASE_SEPOLIA=https://sepolia.base.org

# Next.js frontend RPC overrides
NEXT_PUBLIC_RPC_URL_HEDERA_TESTNET=https://testnet.hashio.io/api
NEXT_PUBLIC_RPC_URL_BASE_SEPOLIA=https://sepolia.base.org

# Optional HTS creation funding for chapter1-asset deploys (Hedera)
# Minimum amount of HBAR to send with MyHTSConnector deployment
HTS_CREATE_FEE_MIN_HBAR=20
# Optional hard override in wei-like units (1 HBAR = 1e18)
# HTS_CREATE_FEE_WEI=20000000000000000000

# Mock-worker relayer (for single-signature bridge UX on testnet)
# Dedicated hot key used by backend API route /api/relayer/bridge
RELAYER_PRIVATE_KEY=
# Safety guardrail for relayer-side processing (ETH-equivalent, 18 decimals)
RELAYER_MAX_BRIDGE_AMOUNT_ETH=1
# Optional separate cap for Base→Hedera vault deposits (defaults to RELAYER_MAX_BRIDGE_AMOUNT_ETH)
RELAYER_MAX_VAULT_AMOUNT_ETH=1
# Optional separate cap for Hedera→Base vault redeem-to-Base (defaults to RELAYER_MAX_VAULT_AMOUNT_ETH)
RELAYER_MAX_VAULT_REDEEM_AMOUNT_ETH=1
